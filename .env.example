# ===================================================
# ClipSesh Environment Config
# ===================================================

# ClipSesh Version
NEXT_PUBLIC_APP_VERSION=

# Server Settings
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Settings
MONGODB_URI=mongodb://127.0.0.1:27017/clipsesh

# Initial Admin Credentials (created automatically if not present)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Discord Bot Token
DISCORD_BOT_TOKEN=

# CC OAuth2 (optional, for CC login)
CC_CLIENT_ID=
CC_CLIENT_SECRET=
CC_BASE_URL=https://cube.community
# CC_SCOPES=openid profile discord accounts

# Security & Authentication
SECRET_KEY=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Mail Settings
MAIL_EMAIL=
MAIL_PASSWORD=
MAIL_HOST=
MAIL_PORT=
MAIL_FROM=

