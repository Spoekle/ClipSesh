# ===================================================
# ClipSesh Unified Next.js Environment Configuration
# ===================================================

# ClipSesh Version
NEXT_PUBLIC_APP_VERSION=

# Server Settings (optional, Next.js defaults to port 3000 on localhost)
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Settings
MONGODB_URI=mongodb://127.0.0.1:27017/clipsesh

# Initial Admin Credentials (created automatically if not present)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Discord Bot Token (for automatic clip ingestion from Discord channels)
# Monitored channels and blacklists are configured in Admin Settings
DISCORD_BOT_TOKEN=



# CC OAuth2 (optional, for CC login)
CC_CLIENT_ID=
CC_CLIENT_SECRET=
CC_BASE_URL=https://cube.community
# CC_SCOPES=openid profile discord accounts

# Security & Authentication
SECRET_KEY=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Mail Settings (optional, for password resets)
MAIL_EMAIL=
MAIL_PASSWORD=

