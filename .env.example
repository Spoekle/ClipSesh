# ===================================================
# ClipSesh Unified Next.js Environment Configuration
# ===================================================

# Server Settings
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=development

# Database Settings
MONGODB_URI=mongodb://127.0.0.1:27017/clipsesh

# Initial Admin Credentials (created automatically if not present)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Discord Bot Token (for automatic clip ingestion from Discord channels)
# Monitored channels and blacklists are configured in Admin Settings
DISCORD_BOT_TOKEN=

# Discord OAuth2 (optional, for linking Discord accounts to user profiles)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Security & Authentication
SECRET_KEY=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
BOT_TOKEN_EXPIRES_IN=30d

# Mail Settings (optional, for password resets)
MAIL_EMAIL=
MAIL_PASSWORD=

# URLs (both point to the unified Next.js server)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

